# Normalize line endings to LF for text files
*           text=auto eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.webp      binary
*.ico       binary
